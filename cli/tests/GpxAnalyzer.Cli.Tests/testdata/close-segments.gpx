<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two <trkseg> a single minute apart. The gap is far below the 10-minute recording-gap
  threshold, so nothing but the segment structure itself distinguishes the boundary: any
  stage that loses it silently merges the two recordings into one.

  Each segment climbs 20 m over two minutes and the 30 m step across the boundary is not
  climbed at all, so honouring the boundary gives +40 m over 4 minutes of recorded time and
  losing it gives +70 m over 5.
-->
<gpx version="1.1" creator="test" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Close Segments</name>
    <trkseg>
      <trkpt lat="45.000" lon="6.0"><ele>100.0</ele><time>2024-01-01T10:00:00Z</time></trkpt>
      <trkpt lat="45.001" lon="6.0"><ele>110.0</ele><time>2024-01-01T10:01:00Z</time></trkpt>
      <trkpt lat="45.002" lon="6.0"><ele>120.0</ele><time>2024-01-01T10:02:00Z</time></trkpt>
    </trkseg>
    <trkseg>
      <trkpt lat="45.003" lon="6.0"><ele>150.0</ele><time>2024-01-01T10:03:00Z</time></trkpt>
      <trkpt lat="45.004" lon="6.0"><ele>160.0</ele><time>2024-01-01T10:04:00Z</time></trkpt>
      <trkpt lat="45.005" lon="6.0"><ele>170.0</ele><time>2024-01-01T10:05:00Z</time></trkpt>
    </trkseg>
  </trk>
</gpx>
