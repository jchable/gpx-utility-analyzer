<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>gpx-ai-analyzer</AssemblyName>
    <RootNamespace>GpxAiAnalyzer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLI parsing -->
    <PackageReference Include="System.CommandLine" Version="2.*" />

    <!-- Microsoft.Extensions.AI core -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="*" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="*" />

    <!-- OpenAI / Azure OpenAI -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="*-*" />
    <PackageReference Include="Azure.AI.OpenAI" Version="2.*" />
    <PackageReference Include="Azure.Identity" Version="1.*" />

    <!-- Anthropic -->
    <PackageReference Include="Anthropic.SDK" Version="*" />

    <!-- Mistral -->
    <PackageReference Include="Mistral.SDK" Version="*" />

    <!-- Ollama -->
    <PackageReference Include="OllamaSharp" Version="*" />
  </ItemGroup>

</Project>
